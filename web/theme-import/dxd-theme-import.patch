+
+interface Props {
+	onClose: () => void;
+	onSaved: (id: string) => void;
+}
+
+export function BetterDiscordImport({onClose, onSaved}: Props) {
+	const {i18n} = useLingui();
+	const labelId = useId();
+	const readSequence = useRef(0);
+	const wallpaperRequest = useRef<AbortController | null>(null);
+	const [source, setSource] = useState('');
+	const [fileName, setFileName] = useState('imported.theme.css');
+	const [settings, setSettings] = useState<ImportedThemeSettings | null>(null);
+	const [wallpaper, setWallpaper] = useState<string | null>(null);
+	const [error, setError] = useState('');
+	const [status, setStatus] = useState('');
+	const [busy, setBusy] = useState(false);
+	const [savedId, setSavedId] = useState<string | null>(null);
+	const origin = window.location.origin;
+	useEffect(
+		() => () => {
+			++readSequence.current;
+			wallpaperRequest.current?.abort();
+			wallpaperRequest.current = null;
+		},
+		[],
+	);
+	const startWallpaperDownload = async (url: string) => {
+		wallpaperRequest.current?.abort();
+		const controller = new AbortController();
+		wallpaperRequest.current = controller;
+		const timer = window.setTimeout(() => controller.abort(), 25000);
+		setBusy(true);
+		setStatus(i18n._(M.backgroundLoading));
+		try {
+			const blob = await downloadThemeWallpaper(
+				url,
+				origin,
+				async (sourceUrl, signal) => {
+					const response = await http.post<{entries: Array<{proxy_url: string}>}>(
+						Endpoints.USER_FAVORITE_GIFS_RESOLVE(),
+						{
+							body: {urls: [sourceUrl]},
+							signal,
+							timeoutMs: 20000,
+							retries: 0,
+							mode: 'silent',
+							suppressContentBlockedModal: true,
+						},
+					);
+					return response.body.entries[0]?.proxy_url ?? '';
+				},
+				controller.signal,
+			);
+			const data = await prepareThemeWallpaper(blob);
+			if (wallpaperRequest.current !== controller || controller.signal.aborted) return;
+			setWallpaper(data);
+			setStatus(i18n._(M.backgroundLoaded));
+		} catch {
+			if (wallpaperRequest.current === controller) setStatus('');
+		} finally {
+			window.clearTimeout(timer);
+			if (wallpaperRequest.current === controller) {
+				wallpaperRequest.current = null;
+				setBusy(false);
+			}
+		}
+	};
+	const analyse = async (css: string, name: string) => {
+		wallpaperRequest.current?.abort();
+		wallpaperRequest.current = null;
+		setError('');
+		setStatus('');
+		setSavedId(null);
+		try {
+			const parsed = parseBetterDiscordTheme(css, name);
+			setSettings(parsed);
+			const localWallpaper = resolveImportWallpaper(parsed.wallpaper, origin);
+			setWallpaper(localWallpaper);
+			if (parsed.wallpaper && !localWallpaper) await startWallpaperDownload(parsed.wallpaper);
+		} catch {
+			setSettings(null);
+			setWallpaper(null);
+			setError(i18n._(M.tooLarge));
+		}
+	};
+	const loadCss = async (event: ChangeEvent<HTMLInputElement>) => {
+		const file = event.target.files?.[0];
+		event.target.value = '';
+		if (!file) return;
+		const sequence = ++readSequence.current;
+		setError('');
+		if (!/\.css$/i.test(file.name) || !file.size || file.size > MAX_THEME_BYTES) {
+			setError(i18n._(M.tooLarge));
+			return;
+		}
+		try {
+			setBusy(true);
+			const css = await file.text();
+			if (sequence !== readSequence.current) return;
+			setSource(css);
+			setFileName(file.name);
+			await analyse(css, file.name);
+		} catch {
+			setError(i18n._(M.failure));
+		} finally {
+			setBusy(false);
+		}
+	};
+	const loadImage = async (event: ChangeEvent<HTMLInputElement>) => {
+		const file = event.target.files?.[0];
+		event.target.value = '';
+		if (!file) return;
+		setError('');
+		try {
+			setBusy(true);
+			const data = await prepareThemeWallpaper(file);
+			setWallpaper(data);
+			setStatus('');
+		} catch {
+			setError(i18n._(M.badImage));
+		} finally {
+			setBusy(false);
+		}
+	};
+	const save = async (apply: boolean) => {
+		if (!settings) return;
+		setBusy(true);
+		setError('');
+		setStatus('');
+		try {
+			await ThemeLibrary.init();
+			const css = buildImportedTheme(settings, wallpaper, origin);
+			const name = fileName.replace(/\.css$/i, '-DxD.css');
+			const existing = ThemeLibrary.themes.find((theme) => theme.id === savedId);
+			const theme = ThemeLibrary.createThemeFromCss(
+				css,
+				name,
+				'import',
+				existing ? {id: existing.id, createdAt: existing.createdAt} : undefined,
+			);
+			await ThemeLibrary.saveTheme(theme);
+			setSavedId(theme.id);
+			if (apply) {
+				await ThemeLibrary.applyImportedTheme(theme.id);
+			}
+			broadcastThemeStudioMessage({type: 'themeLibrary', revision: ThemeLibrary.revision});
+			onSaved(theme.id);
+			setStatus(i18n._(apply ? M.applied : M.saved));
+		} catch {
+			setError(i18n._(M.failure));
+		} finally {
+			setBusy(false);
+		}
+	};
+	const adjust = (key: 'opacity' | 'dimming' | 'blur', value: number) => {
+		setSettings((old) => (old ? {...old, [key]: value} : null));
+		setStatus('');
+	};
+	return (
+		<section
+			className={styles.importer}
+			aria-labelledby={labelId}
+			data-flx="theme-studio.better-discord-import.importer"
+		>
+			<div className={styles.heading} data-flx="theme-studio.better-discord-import.heading">
+				<h2 id={labelId} data-flx="theme-studio.better-discord-import.h2">
+					{i18n._(M.title)}
+				</h2>
+				<StudioButton
+					onClick={onClose}
+					disabled={busy && !wallpaperRequest.current}
+					data-flx="theme-studio.better-discord-import.studio-button.close"
+				>
+					{i18n._(M.close)}
+				</StudioButton>
+			</div>
+			<p data-flx="theme-studio.better-discord-import.p">{i18n._(M.intro)}</p>
+			<div className={styles.inputs} data-flx="theme-studio.better-discord-import.inputs">
+				<label data-flx="theme-studio.better-discord-import.label">
+					{i18n._(M.file)}
+					<input
+						type="file"
+						accept=".css,text/css"
+						onChange={(event) => void loadCss(event)}
+						disabled={busy}
+						data-flx="theme-studio.better-discord-import.input.file"
+					/>
+				</label>
+				<details data-flx="theme-studio.better-discord-import.details">
+					<summary data-flx="theme-studio.better-discord-import.summary">{i18n._(M.paste)}</summary>
+					<textarea
+						aria-label={i18n._(M.paste)}
+						value={source}
+						maxLength={MAX_THEME_BYTES}
+						disabled={busy}
+						data-flx="theme-studio.better-discord-import.textarea.set-source"
+						onChange={(event) => {
+							++readSequence.current;
+							setSource(event.target.value);
+							setSettings(null);
+							setStatus('');
+						}}
+					/>
+					<StudioButton
+						onClick={() => void analyse(source, fileName)}
+						disabled={busy || !source.trim()}
+						data-flx="theme-studio.better-discord-import.studio-button.analyse"
+					>
+						{i18n._(M.analyse)}
+					</StudioButton>
+				</details>
+			</div>
+			{settings && (
+				<div className={styles.result} data-flx="theme-studio.better-discord-import.result">
+					<div className={styles.controls} data-flx="theme-studio.better-discord-import.controls">
+						<label data-flx="theme-studio.better-discord-import.label--2">
+							{i18n._(M.name)}
+							<input
+								value={settings.name}
+								maxLength={140}
+								disabled={busy}
+								onChange={(event) => setSettings({...settings, name: event.target.value})}
+								data-flx="theme-studio.better-discord-import.input.set-settings"
+							/>
+						</label>
+						<label data-flx="theme-studio.better-discord-import.label--3">
+							{i18n._(M.accent)}
+							<input
+								value={settings.accent}
+								maxLength={80}
+								disabled={busy}
+								onChange={(event) => setSettings({...settings, accent: event.target.value})}
+								data-flx="theme-studio.better-discord-import.input.set-settings--2"
+							/>
+						</label>
+						{(['opacity', 'dimming', 'blur'] as const).map((key) => (
+							<label key={key} data-flx="theme-studio.better-discord-import.label--4">
+								{`${i18n._(M[key])}: ${key === 'blur' ? `${settings[key]} px` : `${Math.round(settings[key] * 100)}%`}`}
+								<input
+									type="range"
+									min={0}
+									max={key === 'blur' ? 24 : key === 'dimming' ? 0.9 : 1}
+									step={key === 'blur' ? 1 : 0.01}
+									value={settings[key]}
+									disabled={busy}
+									onChange={(event) => adjust(key, Number(event.target.value))}
+									data-flx="theme-studio.better-discord-import.input.adjust.range"
+								/>
+							</label>
+						))}
+						<label data-flx="theme-studio.better-discord-import.label--5">
+							{i18n._(M.backgroundFile)}
+							<input
+								type="file"
+								accept="image/png,image/jpeg,image/webp,image/gif"
+								onChange={(event) => void loadImage(event)}
+								disabled={busy}
+								data-flx="theme-studio.better-discord-import.input.file--2"
+							/>
+						</label>
+						{wallpaper && (
+							<StudioButton
+								onClick={() => setWallpaper(null)}
+								disabled={busy}
+								data-flx="theme-studio.better-discord-import.studio-button.set-wallpaper"
+							>
+								{i18n._(M.remove)}
+							</StudioButton>
+						)}
+						{wallpaper?.startsWith('data:') && (
+							<p data-flx="theme-studio.better-discord-import.p--2">{i18n._(M.backgroundEmbedded)}</p>
+						)}
+					</div>
+					<div data-flx="theme-studio.better-discord-import.div">
+						<p data-flx="theme-studio.better-discord-import.p--3">{i18n._(M.preview)}</p>
+						<div
+							className={styles.preview}
+							style={{
+								backgroundImage: wallpaper ? `url(${JSON.stringify(wallpaper)})` : undefined,
+								backgroundColor: settings.appearance?.canvas,
+								fontFamily: settings.font,
+							}}
+							data-flx="theme-studio.better-discord-import.preview"
+						>
+							<div
+								className={styles.shade}
+								style={{background: panelBackground(settings.appearance?.overlay ?? '#000', settings.dimming)}}
+								data-flx="theme-studio.better-discord-import.shade"
+							/>
+							<div className={styles.previewInner} data-flx="theme-studio.better-discord-import.preview-inner">
+								<aside
+									style={{background: panelBackground(settings.appearance?.sidebar ?? 'rgba(0,0,0,.25)', settings.opacity), backdropFilter: `blur(${settings.blur}px)`}}
+									data-flx="theme-studio.better-discord-import.aside"
+								>
+									<span data-flx="theme-studio.better-discord-import.span">DxD</span>
+									<br data-flx="theme-studio.better-discord-import.br" />
+									<br data-flx="theme-studio.better-discord-import.br--2" />
+									<span data-flx="theme-studio.better-discord-import.span--2">{`# ${i18n._(M.sampleTitle)}`}</span>
+								</aside>
+								<div
+									className={styles.previewChat}
+									style={{color: settings.text, background: settings.appearance?.chat ?? 'transparent'}}
+									data-flx="theme-studio.better-discord-import.preview-chat"
+								>
+									<strong style={{background: settings.appearance?.header}} data-flx="theme-studio.better-discord-import.strong"># {i18n._(M.sampleTitle)}</strong>
+									<p data-flx="theme-studio.better-discord-import.p--4">{i18n._(M.sample)}</p>
+									<span style={{color: settings.muted, background: settings.appearance?.composer}} data-flx="theme-studio.better-discord-import.span">
+										{i18n._(M.sampleInput)}
+									</span>
+									<div
+										className={styles.swatch}
+										style={{background: settings.appearance?.button ?? settings.accent, color: settings.appearance?.buttonText ?? '#fff'}}
+										data-flx="theme-studio.better-discord-import.swatch"
+									>
+										DxD
+									</div>
+								</div>
+							</div>
+						</div>
+						<h3 data-flx="theme-studio.better-discord-import.h3">{i18n._(M.report)}</h3>
+						<p data-flx="theme-studio.better-discord-import.p--5">
+							{i18n._(M.mapped)}:{' '}
+							{settings.mapped.length
+								? settings.mapped.map((key) => i18n._(M[key as keyof typeof M])).join(', ')
+								: i18n._(M.none)}
+						</p>
+						<p data-flx="theme-studio.better-discord-import.p--6">
+							{i18n._(M.font)}: {settings.font}
+						</p>
+						<p data-flx="theme-studio.better-discord-import.p--7">{i18n._(M.ignored)}</p>
+						<p data-flx="theme-studio.better-discord-import.p--8">
+							{i18n._(M.counts)}: {settings.ignoredRules} / {settings.imports}
+						</p>
+						{!!settings.unsupportedVariables.length && (
+							<details data-flx="theme-studio.better-discord-import.details--2">
+								<summary data-flx="theme-studio.better-discord-import.summary--2">
+									{i18n._(M.variables)} ({settings.unsupportedVariables.length})
+								</summary>
+								<code className={styles.variables} data-flx="theme-studio.better-discord-import.variables">
+									{settings.unsupportedVariables.join(', ')}
+								</code>
+							</details>
+						)}
+						{settings.wallpaper && !resolveImportWallpaper(settings.wallpaper, origin) && !wallpaper && !busy && (
+							<p className={styles.warning} data-flx="theme-studio.better-discord-import.warning">
+								{i18n._(M.backgroundBlocked)}
+								<StudioButton
+									onClick={() => {
+										if (settings.wallpaper) void startWallpaperDownload(settings.wallpaper);
+									}}
+									data-flx="theme-studio.better-discord-import.studio-button"
+								>
+									{i18n._(M.backgroundRetry)}
+								</StudioButton>
+								<br data-flx="theme-studio.better-discord-import.br--3" />
+								<code className={styles.variables} data-flx="theme-studio.better-discord-import.variables--2">
+									{settings.wallpaper}
+								</code>
+							</p>
+						)}
+					</div>
+				</div>
+			)}
+			{error && (
+				<p role="alert" className={styles.warning} data-flx="theme-studio.better-discord-import.warning--2">
+					{error}
+				</p>
+			)}
+			{status && (
+				<p role="status" data-flx="theme-studio.better-discord-import.status">
+					{status}
+				</p>
+			)}
+			{settings && (
+				<>
+					<div className={styles.actions} data-flx="theme-studio.better-discord-import.actions">
+						<StudioButton
+							variant="primary"
+							disabled={busy || !settings.name.trim()}
+							onClick={() => void save(true)}
+							data-flx="theme-studio.better-discord-import.studio-button"
+						>
+							{i18n._(M.apply)}
+						</StudioButton>
+						<StudioButton
+							variant="secondary"
+							disabled={busy || !settings.name.trim()}
+							onClick={() => void save(false)}
+							data-flx="theme-studio.better-discord-import.studio-button--2"
+						>
+							{i18n._(M.save)}
+						</StudioButton>
+						<StudioButton
+							disabled={busy || !settings.name.trim()}
+							onClick={() =>
+								downloadTextFile(
+									buildImportedTheme(settings, wallpaper, origin),
+									fileName.replace(/\.css$/i, '-DxD.css'),
+									'text/css;charset=utf-8',
+								)
+							}
+							data-flx="theme-studio.better-discord-import.studio-button.download-text-file"
+						>
+							{i18n._(M.download)}
+						</StudioButton>
+					</div>
+					<p data-flx="theme-studio.better-discord-import.p--9">{i18n._(M.local)}</p>
+				</>
+			)}
+		</section>
+	);
+}
