index 0000000..19ec8a3
--- /dev/null
+++ b/fluxer_app/src/features/theme_studio/utils/BetterDiscordImport.ts
@@ -0,0 +1,403 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import {
+	colorAlpha,
+	panelBackground,
+	readThemeAppearance,
+	safeSurface,
+	type ThemeAppearance,
+} from './ThemeAppearanceImport';
+
+// Read CSS in a detached CSSOM. Never attach the imported stylesheet: Discord
+// selectors, @imports, animations and arbitrary declarations are not executed.
+export interface ImportedThemeSettings {
+	name: string;
+	author: string;
+	accent: string;
+	hover: string;
+	text: string;
+	muted: string;
+	font: string;
+	mono: string;
+	wallpaper: string | null;
+	opacity: number;
+	dimming: number;
+	blur: number;
+	mapped: Array<string>;
+	imports: number;
+	ignoredRules: number;
+	unsupportedVariables: Array<string>;
+	appearance?: ThemeAppearance;
+}
+
+export const MAX_THEME_BYTES = 1024 * 1024;
+export const MAX_WALLPAPER_BYTES = 8 * 1024 * 1024;
+// Base64 expansion plus generated CSS must fit the native 1 MiB CSS reader.
+export const MAX_EMBEDDED_WALLPAPER_BYTES = 640 * 1024;
+
+// CSSOM implementations differ in how replaceSync handles @import. Remove only
+// top-level imports before parsing, respecting comments, strings and url(...).
+function withoutImports(css: string): {css: string; imports: number} {
+	let output = '';
+	let imports = 0;
+	let depth = 0;
+	let quote = '';
+	let comment = false;
+	let importing = false;
+	let parentheses = 0;
+	for (let i = 0; i < css.length; i++) {
+		const char = css[i];
+		if (comment) {
+			if (char === '*' && css[i + 1] === '/') {
+				comment = false;
+				i++;
+			}
+			continue;
+		}
+		if (quote) {
+			if (!importing) output += char;
+			if (char === '\\') {
+				if (!importing && i + 1 < css.length) output += css[i + 1];
+				i++;
+			} else if (char === quote) quote = '';
+			continue;
+		}
+		if (char === '/' && css[i + 1] === '*') {
+			comment = true;
+			i++;
+			if (!importing) output += ' ';
+			continue;
+		}
+		if (char === '"' || char === "'") {
+			quote = char;
+			if (!importing) output += char;
+			continue;
+		}
+		if (!depth && !importing && char === '@' && /^@import\b/i.test(css.slice(i, i + 8))) {
+			importing = true;
+			imports++;
+		}
+		if (importing) {
+			if (char === '(') parentheses++;
+			if (char === ')') parentheses--;
+			if (char === ';' && !parentheses) {
+				importing = false;
+				output += '\n';
+			}
+			continue;
+		}
+		if (char === '{') depth++;
+		if (char === '}') depth = Math.max(0, depth - 1);
+		output += char;
+	}
+	return {css: output, imports};
+}
+
+const COLOR_KEYS = {
+	accent: ['--main-color', '--accent-color', '--brand-experiment', '--accent', '--brand-500'],
+	hover: ['--hover-color', '--accent-hover'],
+	text: ['--normal-text', '--text-normal', '--text-primary'],
+	muted: ['--muted-text', '--text-muted'],
+} as const;
+const FONT_KEYS = ['--main-font', '--font-primary', '--font', '--font-family'];
+const MONO_KEYS = ['--code-font', '--font-code', '--font-mono'];
+const BACKGROUND_KEYS = [
+	'--background-image',
+	'--background-url',
+	'--theme-background-image',
+	'--app-bg',
+	'--wallpaper',
+];
+
+function metadata(css: string, key: string, fallback: string): string {
+	const header = /^\s*\/\*[\s\S]*?\*\//.exec(css)?.[0] ?? '';
+	return (new RegExp(`@${key}\\s+([^\\r\\n*]+)`, 'i').exec(header)?.[1]?.trim() || fallback)
+		.replace(/[\r\n<>*]/g, '')
+		.slice(0, 160);
+}
+
+export function safeColor(value: string): boolean {
+	if (!/^(?:#[\da-f]{3,4}|#[\da-f]{6}|#[\da-f]{8}|(?:rgb|hsl)a?\([\d\s.,%+/\-deg]+\)|[a-z]+)$/i.test(value))
+		return false;
+	return typeof CSS !== 'undefined' && typeof CSS.supports === 'function'
+		? CSS.supports('color', value)
+		: /^(?:#|rgba?\(|hsla?\(|white$|black$|transparent$)/i.test(value);
+}
+
+function safeFont(value: string): boolean {
+	return value.length <= 300 && /^[\p{L}\p{N}\s,'"_-]+$/u.test(value);
+}
+
+export function safeWallpaper(value: string, origin: string): string | null {
+	// Only raster data URLs generated from local files, or same-origin HTTPS.
+	if (/^data:image\/(?:png|jpeg|webp|gif);base64,[A-Za-z0-9+/=]+$/.test(value)) return value;
+	try {
+		const url = new URL(value, origin);
+		if (url.protocol === 'https:' && url.origin === origin && !url.username && !url.password) return url.href;
+	} catch {
+		/* Invalid URL. */
+	}
+	return null;
+}
+
+export function parseBetterDiscordTheme(css: string, fileName: string): ImportedThemeSettings {
+	if (new TextEncoder().encode(css).length > MAX_THEME_BYTES) throw new Error('tooLarge');
+	if (!css.trim()) throw new Error('empty');
+	const stripped = withoutImports(css);
+	const sheet = new CSSStyleSheet();
+	sheet.replaceSync(stripped.css);
+	const variables = new Map<string, string>();
+	let fallbackBackground = '';
+	const imports = stripped.imports;
+	let ignoredRules = 0;
+	const styleRules: Array<CSSStyleRule> = [];
+	// Deliberately use the dark palette, matching the translucent dark preview.
+	const walk = (rules: CSSRuleList) => {
+		for (const rule of Array.from(rules)) {
+			if ('selectorText' in rule && 'style' in rule) {
+				const styleRule = rule as CSSStyleRule;
+				styleRules.push(styleRule);
+				const selector = styleRule.selectorText;
+				const primarySelector = selector.replace(/^:is\(\s*/, '').split(',')[0];
+				if (
+					!/theme-light|theme-midnight|theme-darker/.test(primarySelector) &&
+					/:root|theme-dark|^\s*(?:body|html)\s*$/.test(primarySelector)
+				) {
+					for (let index = 0; index < styleRule.style.length; index++) {
+						const name = styleRule.style.item(index);
+						if (name.startsWith('--')) variables.set(name, styleRule.style.getPropertyValue(name).trim());
+					}
+				}
+				if (/^\s*(?:\.app(?:__|[-_])[^ ,]*|body|html)\s*$/.test(selector)) {
+					fallbackBackground ||= styleRule.style.getPropertyValue('background-image');
+				}
+				ignoredRules++;
+			} else if ('cssRules' in rule && !/^@(?:keyframes|font-face|media)/i.test(rule.cssText)) {
+				if (
+					rule.cssText.startsWith('@supports') &&
+					'conditionText' in rule &&
+					!CSS.supports(String(rule.conditionText))
+				)
+					continue;
+				walk((rule as CSSGroupingRule).cssRules);
+			}
+		}
+	};
+	walk(sheet.cssRules);
+	if (!sheet.cssRules.length && !imports) throw new Error('empty');
+	const used = new Set<string>();
+	const resolve = (value: string, seen = new Set<string>()): string =>
+		value.replace(/var\(\s*(--[\w-]+)\s*(?:,\s*([^()]*))?\)/g, (_match, key: string, fallback: string | undefined) => {
+			if (seen.has(key) || seen.size > 12) return '';
+			used.add(key);
+			return resolve(variables.get(key) ?? fallback ?? '', new Set([...seen, key]));
+		});
+	const pick = (keys: ReadonlyArray<string>, validate: (value: string) => boolean): string | undefined => {
+		for (const key of keys) {
+			if (!variables.has(key)) continue;
+			const value = resolve(variables.get(key)!).trim();
+			if (validate(value)) {
+				used.add(key);
+				return value;
+			}
+		}
+		return undefined;
+	};
+	const mapped: Array<string> = [];
+	const inferred = readThemeAppearance(styleRules, variables, resolve, safeColor);
+	for (const variable of inferred.metadataVariables) used.add(variable);
+	const colors = {accent: '#2780e6', hover: '#1e63b3', text: '#f0f6ff', muted: '#a5b9d1'};
+	for (const key of Object.keys(COLOR_KEYS) as Array<keyof typeof COLOR_KEYS>) {
+		const value = pick(COLOR_KEYS[key], safeColor);
+		if (value) {
+			colors[key] = value;
+			mapped.push(key);
+		}
+	}
+	if (!mapped.includes('accent')) {
+		const hue = variables.get('--accent-hue')?.trim();
+		const saturation = variables.get('--accent-saturation')?.trim();
+		const lightness = variables.get('--accent-lightness')?.trim();
+		const hsl = `hsl(${hue},${saturation},${lightness})`;
+		if (hue && saturation && lightness && safeColor(hsl)) {
+			colors.accent = hsl;
+			mapped.push('accent');
+			for (const key of ['--accent-hue', '--accent-saturation', '--accent-lightness']) used.add(key);
+		} else if (inferred.accent) {
+			colors.accent = inferred.accent;
+			mapped.push('accent');
+		}
+	}
+	if (!mapped.includes('hover')) colors.hover = colors.accent;
+	if (!mapped.includes('text') && inferred.text) {
+		colors.text = inferred.text;
+		mapped.push('text');
+	}
+	if (!mapped.includes('muted') && inferred.muted) {
+		colors.muted = inferred.muted;
+		mapped.push('muted');
+	}
+	if (Object.keys(inferred.appearance).length) mapped.push('surfaces');
+	const font = pick(FONT_KEYS, safeFont);
+	const mono = pick(MONO_KEYS, safeFont);
+	if (font || mono) mapped.push('font');
+	const background = pick(BACKGROUND_KEYS, (value) => /^url\(/i.test(value)) ?? fallbackBackground;
+	const rawUrl = /^url\(\s*(?:"([^"\n]+)"|'([^'\n]+)'|([^\s)'";]+))\s*\)$/i.exec(background.trim());
+	let wallpaper: string | null = null;
+	if (rawUrl) {
+		try {
+			const url = new URL(rawUrl[1] ?? rawUrl[2] ?? rawUrl[3]);
+			if (url.protocol === 'https:' && !url.username && !url.password) wallpaper = url.href;
+		} catch {
+			/* Unusable relative or unsafe background. */
+		}
+	}
+	if (wallpaper) mapped.push('wallpaper');
+	const alpha = inferred.opacity;
+	if (alpha !== undefined) mapped.push('opacity');
+	const blur = pick(['--popout-blur', '--app-blur', '--backdrop-blur'], (value) => /^\d{1,2}(?:\.\d+)?px$/.test(value));
+	return {
+		name: metadata(css, 'name', fileName.replace(/(?:\.theme)?\.css$/i, '') || 'Imported theme'),
+		author: metadata(css, 'author', ''),
+		...colors,
+		font: font ?? 'Arial, sans-serif',
+		mono: mono ?? 'Consolas, monospace',
+		wallpaper,
+		opacity: alpha ?? 0.25,
+		dimming: inferred.dimming ?? 0,
+		blur: blur ? Math.min(24, parseFloat(blur)) : 0,
+		appearance: inferred.appearance,
+		mapped,
+		imports,
+		ignoredRules: Math.max(0, ignoredRules - inferred.matchedRules),
+		unsupportedVariables: [...variables.keys()].filter((key) => !used.has(key)),
+	};
+}
+
+export function resolveImportWallpaper(wallpaper: string | null, origin: string): string | null {
+	if (!wallpaper) return null;
+	if (wallpaper === 'https://clearvision.github.io/images/sapphire.jpg') {
+		return `${origin}/theme-assets/clearvision-sapphire.jpg`;
+	}
+	if (wallpaper === 'https://i.imgur.com/1JVM8CU.jpg') {
+		return `${origin}/theme-assets/akame.jpg`;
+	}
+	return safeWallpaper(wallpaper, origin);
+}
+
+export function buildImportedTheme(settings: ImportedThemeSettings, wallpaper: string | null, origin: string): string {
+	const clean = (text: string) => text.replace(/[\r\n*<>]/g, '').slice(0, 160);
+	const number = (value: number, min: number, max: number, fallback: number) =>
+		Number.isFinite(value) ? Math.min(max, Math.max(min, value)) : fallback;
+	const image = wallpaper ? safeWallpaper(wallpaper, origin) : null;
+	const accent = safeColor(settings.accent) ? settings.accent : '#2780e6';
+	const hover = safeColor(settings.hover) ? settings.hover : '#1e63b3';
+	const text = safeColor(settings.text) ? settings.text : '#f0f6ff';
+	const muted = safeColor(settings.muted) ? settings.muted : '#a5b9d1';
+	const rawAppearance = settings.appearance ?? {};
+	const surface = (key: keyof ThemeAppearance, fallback: string) => {
+		const value = rawAppearance[key];
+		return value && safeSurface(value, safeColor) ? value : fallback;
+	};
+	const sidebar = surface('sidebar', 'rgba(0,0,0,.25)');
+	const members = surface('members', sidebar);
+	const chat = surface('chat', 'transparent');
+	const header = surface('header', 'transparent');
+	const composer = surface('composer', 'rgba(0,0,0,.35)');
+	const userArea = surface('userArea', 'rgba(0,0,0,.3)');
+	const embed = surface('embed', 'rgba(0,0,0,.5)');
+	const selected = surface('selected', `color-mix(in srgb, ${accent} 45%, transparent)`);
+	const hovered = surface('hover', `color-mix(in srgb, ${accent} 20%, transparent)`);
+	const buttonText =
+		rawAppearance.buttonText && safeColor(rawAppearance.buttonText) ? rawAppearance.buttonText : '#fff';
+	const opacity = number(settings.opacity, 0, 1, 0.25);
+	const membersAlphaDelta = (colorAlpha(members) ?? opacity) - (colorAlpha(sidebar) ?? opacity);
+	const panel = (color: string, alpha: string) => (safeColor(color) ? panelBackground(color, alpha) : color);
+	const targets = (...names: Array<string>) => names.map((name) => `[class*="${name}___"]`).join(',\n');
+	const overlay = rawAppearance.overlay && safeColor(rawAppearance.overlay) ? rawAppearance.overlay : '#000';
+	const shade = `rgb(from ${overlay} r g b / var(--dxd-wallpaper-dimming))`;
+	return `/**
+ * @name ${clean(settings.name)} for DxD
+ * @author ${clean(settings.author) || 'Original theme author'} · DxD importer
+ * @version 1.0.0
+ * @description Personal adaptation for Fluxer. Original Discord layout and imports are omitted.
+ */
+:root, .theme-dark, .theme-coal {
+ --dxd-wallpaper: ${image ? `url(${JSON.stringify(image)})` : 'none'};
+ --dxd-panel-opacity: ${opacity};
+ --dxd-wallpaper-dimming: ${number(settings.dimming, 0, 0.9, 0)};
+ --dxd-panel-blur: ${number(settings.blur, 0, 24, 0)}px;
+ --brand-primary: ${accent} !important;
+ --brand-primary-fill: ${buttonText} !important;
+ --brand-secondary: ${hover} !important;
+ --accent-primary: ${accent} !important;
+ --button-primary-fill: ${accent} !important;
+ --button-primary-active-fill: ${hover} !important;
+ --button-primary-text: ${buttonText} !important;
+ --text-primary: ${text} !important;
+ --text-chat: ${text} !important;
+ --text-secondary: ${muted} !important;
+ --text-muted: ${muted} !important;
+ --text-link: ${surface('link', accent)} !important;
+ --font-sans: ${safeFont(settings.font) ? settings.font : 'Arial, sans-serif'} !important;
+ --font-mono: ${safeFont(settings.mono) ? settings.mono : 'Consolas, monospace'} !important;
+ --background-primary: ${chat} !important;
+ --background-secondary: ${sidebar} !important;
+ --background-secondary-alt: ${userArea} !important;
+ --background-secondary-lighter: ${header} !important;
+ --background-tertiary: ${surface('guilds', 'transparent')} !important;
+ --background-channel-header: ${header} !important;
+ --background-header-primary: ${header} !important;
+ --background-textarea: ${composer} !important;
+ --composer-surface-color: ${composer} !important;
+ --panel-control-bg: ${userArea} !important;
+ --form-surface-background: ${surface('menu', 'rgba(16,16,20,.96)')} !important;
+ --background-modifier-selected: ${selected} !important;
+ --background-modifier-hover: ${hovered} !important;
+ --surface-interactive-selected-bg: ${selected} !important;
+ --surface-interactive-hover-bg: ${hovered} !important;
+ --surface-interactive-selected-color: ${text} !important;
+ --channel-item-selected-background: ${selected} !important;
+ --channel-item-hover-background: ${hovered} !important;
+ --scrollbar-thumb: ${accent} !important;
+ --border-color: ${surface('border', 'rgba(255,255,255,.15)')} !important;
+}
+[class*="App.module__appContainer"] {
+ background: linear-gradient(${shade},${shade}), var(--dxd-wallpaper), ${surface('canvas', '#101014')} !important;
+ background-position: center !important;
+ background-size: cover !important;
+ background-repeat: no-repeat !important;
+}
+${['GuildsLayout.module__guildsLayoutContainer', 'GuildsLayout.module__contentContainer', 'GuildsLayout.module__contentInner', 'GuildLayout.module__guildLayoutContainer', 'GuildLayout.module__guildMainContent', 'ChannelLayout.module__channelLayoutContainer', 'ChannelIndexPage.module__channelGrid', 'ChannelListContent.module__channelListScroller', 'MemberListContainer.module__memberListScroller', 'OutlineFrame.module__frame'].map((name) => `[class*="${name}"]`).join(',\n')} {
+ background: transparent !important;
+}
+${targets('GuildNavbar.module__guildNavbarContainer')} {
+ background: ${sidebar} !important;
+ background: ${panel(sidebar, 'var(--dxd-panel-opacity)')} !important;
+ backdrop-filter: blur(var(--dxd-panel-blur));
+}
+${targets('MemberListContainer.module__memberListContainer')} {
+ background: ${members} !important;
+ background: ${panel(members, `clamp(0, calc(var(--dxd-panel-opacity) + ${membersAlphaDelta}), 1)`)} !important;
+ backdrop-filter: blur(var(--dxd-panel-blur));
+}
+${targets('GuildsLayout.module__guildListScrollerWrapper', 'GuildsLayout.module__guildListScrollContainer')} { background: ${surface('guilds', 'transparent')} !important; }
+${targets('ChannelChatLayout.module__container')} { background: ${chat} !important; }
+${targets('ChannelHeader.module__headerContainer')} { background: ${header} !important; }
+${targets('ChannelHeader.module__headerWrapper')} { background: transparent !important; }
+${targets('UserArea.module__userAreaInnerWrapper')} { background: ${userArea} !important; }
+${targets('GuildsLayout.module__userAreaWrapper', 'TextareaInput.module__textarea', 'TextareaInput.module__textareaWrapper')} { background: transparent !important; }
+${targets('EmbedCard.module__wrapper', 'Embed.module__embed', 'AttachmentFile.module__attachmentContainer')} { background: ${embed} !important; }
+${targets('ContextMenu.module__contextMenu')} { background: ${surface('menu', 'rgba(16,16,20,.96)')} !important; }
+${targets('Modal.module__root')} { background: ${surface('modal', 'rgba(16,16,20,.96)')} !important; }
+${targets('Button.module__primary')} {
+ background: ${surface('button', accent)} !important;
+ color: ${buttonText} !important;
+ ${rawAppearance.radius && /^(?:0|\d{1,3}(?:\.\d{1,2})?(?:px|rem))$/.test(rawAppearance.radius) ? `border-radius: ${rawAppearance.radius} !important;` : ''}
+}
+${targets('Button.module__primary')}:hover { background: ${surface('buttonHover', hover)} !important; }
+@media (prefers-reduced-transparency: reduce) {
+ :root, .theme-dark, .theme-coal { --dxd-panel-blur: 0px; }
+}
+`;
+}
