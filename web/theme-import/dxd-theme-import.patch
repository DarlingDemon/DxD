@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import {MAX_EMBEDDED_WALLPAPER_BYTES, MAX_WALLPAPER_BYTES} from './BetterDiscordImport';
+
+const IMAGE_TYPES = new Set(['image/png', 'image/jpeg', 'image/webp', 'image/gif']);
+
+// Only the existing authenticated API resolves external URLs. The actual image
+// fetch receives no session credentials and must stay on our signed media proxy.
+export async function downloadThemeWallpaper(
+	url: string,
+	origin: string,
+	resolveProxy: (url: string, signal: AbortSignal) => Promise<string>,
+	signal: AbortSignal,
+	fetchImage: typeof fetch = fetch,
+): Promise<Blob> {
+	const source = new URL(url);
+	if (source.protocol !== 'https:' || source.username || source.password || url.length > 4096)
+		throw new Error('Invalid wallpaper URL');
+	signal.throwIfAborted();
+	const proxy = new URL(await resolveProxy(source.href, signal));
+	if (proxy.origin !== origin || !proxy.pathname.startsWith('/media/external/') || proxy.username || proxy.password) {
+		throw new Error('Invalid media proxy URL');
+	}
+	signal.throwIfAborted();
+	const response = await fetchImage(proxy.href, {
+		signal,
+		credentials: 'omit',
+		redirect: 'error',
+		referrerPolicy: 'no-referrer',
+	});
+	const type = response.headers.get('content-type')?.split(';')[0].trim().toLowerCase() ?? '';
+	if (!response.ok || !IMAGE_TYPES.has(type) || !response.body) {
+		await response.body?.cancel();
+		throw new Error('Wallpaper unavailable');
+	}
+	const length = Number(response.headers.get('content-length'));
+	if (Number.isFinite(length) && length > MAX_WALLPAPER_BYTES) {
+		await response.body.cancel();
+		throw new Error('Wallpaper too large');
+	}
+	const reader = response.body.getReader();
+	const parts: Array<ArrayBuffer> = [];
+	let bytes = 0;
+	try {
+		while (true) {
+			signal.throwIfAborted();
+			const {done, value} = await reader.read();
+			if (done) break;
+			bytes += value.byteLength;
+			if (bytes > MAX_WALLPAPER_BYTES) throw new Error('Wallpaper too large');
+			parts.push(Uint8Array.from(value).buffer);
+		}
+		if (!bytes) throw new Error('Empty wallpaper');
+		return new Blob(parts, {type});
+	} finally {
+		await reader.cancel().catch(() => {});
+		reader.releaseLock();
+	}
+}
+
+export async function prepareThemeWallpaper(file: Blob): Promise<string> {
+	if (!IMAGE_TYPES.has(file.type) || file.size > MAX_WALLPAPER_BYTES || !file.size) throw new Error('Invalid image');
+	const image = await createImageBitmap(file);
+	let prepared = file;
+	try {
+		if (image.width * image.height > 40_000_000) throw new Error('Image dimensions too large');
+		if (file.size > MAX_EMBEDDED_WALLPAPER_BYTES) {
+			const canvas = document.createElement('canvas');
+			const context = canvas.getContext('2d');
+			if (!context) throw new Error('Canvas unavailable');
+			let scale = Math.min(1, 2048 / Math.max(image.width, image.height));
+			for (let attempt = 0; attempt < 8; attempt++) {
+				canvas.width = Math.max(1, Math.round(image.width * scale));
+				canvas.height = Math.max(1, Math.round(image.height * scale));
+				context.drawImage(image, 0, 0, canvas.width, canvas.height);
+				prepared = await new Promise<Blob>((resolve, reject) =>
+					canvas.toBlob(
+						(blob) => (blob ? resolve(blob) : reject(new Error('Image encoding failed'))),
+						'image/webp',
+						0.82,
+					),
+				);
+				if (prepared.size <= MAX_EMBEDDED_WALLPAPER_BYTES) break;
+				scale *= 0.75;
+			}
+			if (prepared.size > MAX_EMBEDDED_WALLPAPER_BYTES) throw new Error('Image encoding too large');
+		}
+	} finally {
+		image.close();
+	}
+	return new Promise<string>((resolve, reject) => {
+		const reader = new FileReader();
+		reader.onload = () => resolve(String(reader.result));
+		reader.onerror = reject;
+		reader.readAsDataURL(prepared);
+	});
+}
