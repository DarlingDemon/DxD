index 0000000..f918472
--- /dev/null
+++ b/fluxer_app/src/features/theme_studio/utils/ThemeAppearanceImport.ts
@@ -0,0 +1,308 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+// Translate known component roles, never the original selectors. Hashes in a few
+// Discord component names disambiguate otherwise generic "container" wrappers;
+// semantic names below work across themes and Discord CSS-module hash changes.
+export interface ThemeAppearance {
+	canvas?: string;
+	overlay?: string;
+	sidebar?: string;
+	members?: string;
+	guilds?: string;
+	chat?: string;
+	header?: string;
+	composer?: string;
+	userArea?: string;
+	embed?: string;
+	menu?: string;
+	modal?: string;
+	selected?: string;
+	hover?: string;
+	button?: string;
+	buttonHover?: string;
+	buttonText?: string;
+	link?: string;
+	border?: string;
+	radius?: string;
+}
+
+type Surface = Exclude<keyof ThemeAppearance, 'link' | 'border' | 'radius' | 'buttonText'>;
+export interface AppearanceImport {
+	appearance: ThemeAppearance;
+	matchedRules: number;
+	accent?: string;
+	text?: string;
+	muted?: string;
+	dimming?: number;
+	opacity?: number;
+	metadataVariables: Array<string>;
+}
+
+export function colorAlpha(value: string): number | undefined {
+	if (value === 'transparent' || value === 'none') return 0;
+	if (/^#[\da-f]{4}$/i.test(value)) return parseInt(value[4] + value[4], 16) / 255;
+	if (/^#[\da-f]{8}$/i.test(value)) return parseInt(value.slice(7), 16) / 255;
+	const alpha =
+		/\/\s*([\d.]+%?)\s*\)$/.exec(value)?.[1] ??
+		/^(?:rgb|hsl)a?\([^,()]+,[^,()]+,[^,()]+,\s*([\d.]+%?)\s*\)$/i.exec(value)?.[1];
+	if (alpha) return Math.min(1, Math.max(0, parseFloat(alpha) / (alpha.endsWith('%') ? 100 : 1)));
+	return /^(?:#|[a-z]+$|(?:rgb|hsl)a?\()/i.test(value) ? 1 : undefined;
+}
+
+export function safeSurface(value: string, isColor: (value: string) => boolean): boolean {
+	if (/^(?:initial|inherit|unset|revert|revert-layer|currentcolor)$/i.test(value)) return false;
+	if (isColor(value)) return true;
+	if (value.length > 1600 || /[;{}<>@\\]|url\s*\(|var\s*\(|(?:image|paint|element|attr|expression)\s*\(/i.test(value))
+		return false;
+	return (
+		/^(?:-webkit-)?(?:repeating-)?(?:linear|radial|conic)-gradient\(/i.test(value) &&
+		typeof CSS !== 'undefined' &&
+		CSS.supports('background-image', value)
+	);
+}
+
+export function splitSelectors(value: string): Array<string> {
+	const result: Array<string> = [];
+	let depth = 0;
+	let start = 0;
+	let quote = '';
+	for (let i = 0; i < value.length; i++) {
+		const char = value[i];
+		if (quote) {
+			if (char === '\\') i++;
+			else if (char === quote) quote = '';
+			continue;
+		}
+		if (char === '"' || char === "'") quote = char;
+		else if (char === '(' || char === '[') depth++;
+		else if (char === ')' || char === ']') depth--;
+		else if (char === ',' && depth === 0) {
+			result.push(value.slice(start, i).trim());
+			start = i + 1;
+		}
+	}
+	result.push(value.slice(start).trim());
+	return result;
+}
+
+const HASHED_ROLES: Record<string, Surface> = {
+	container__9293f: 'header',
+	themed__9293f: 'header',
+	container_c8ffbb: 'members',
+	container__2637a: 'sidebar',
+	wrapper_ef3116: 'guilds',
+	scroller_ef3116: 'guilds',
+	bg__960e4: 'canvas',
+	container__37e49: 'userArea',
+};
+
+function componentRole(selector: string): {role: Surface; weight: number} | null {
+	const classes = [...selector.matchAll(/\.([a-zA-Z][\w-]*)/g)].map((match) => match[1]);
+	const last = classes.at(-1) ?? '';
+	const name = last.replace(/(?:__?|[-])[\da-f]{5,8}$/i, '');
+	if (/modeSelected|channel.*selected/i.test(selector) && /^(?:link|name|icon|channel)/i.test(name))
+		return {role: 'selected', weight: 40};
+	if (/:hover/.test(selector) && /^(?:link|channel)/i.test(name)) return {role: 'hover', weight: 35};
+	if (/colorBrand|buttonPrimary|primaryButton|lookFilled.*colorBrand/i.test(selector)) {
+		return {role: /:hover|:active/.test(selector) ? 'buttonHover' : 'button', weight: 30};
+	}
+	if (HASHED_ROLES[last]) return {role: HASHED_ROLES[last], weight: 10};
+	const roles: Array<[RegExp, Surface]> = [
+		[/^(?:app|appMount|background|bg)$/, 'canvas'],
+		[/^(?:layers|appOverlay)$/, 'overlay'],
+		[/^(?:sidebar|sidebarList|channels|channelList|privateChannels)$/, 'sidebar'],
+		[/^(?:members|membersWrap|memberList)$/, 'members'],
+		[/^(?:guilds|guildList|serverList)$/, 'guilds'],
+		[/^(?:chat|chatContent|messagesWrapper|messageList|scrollerInner)$/, 'chat'],
+		[/^(?:channelHeader|chatHeader|title)$/, 'header'],
+		[/^(?:channelTextArea|channelTextAreaThemed|messageInput|chatInput)$/, 'composer'],
+		[/^(?:panels|userArea|accountPanel)$/, 'userArea'],
+		[/^(?:embed|embedFull|embedWrapper|file)$/, 'embed'],
+		[/^(?:menu|contextMenu|popout)$/, 'menu'],
+		[/^(?:root|modal|modalContent)$/, 'modal'],
+	];
+	for (const [pattern, role] of roles) if (pattern.test(name)) return {role, weight: 20};
+	if (name === 'scrollableContainer') return {role: 'composer', weight: 1};
+	return null;
+}
+
+const TOKEN_SURFACES: Array<[Surface, Array<string>]> = [
+	['sidebar', ['--sidebar-color', '--background-secondary', '--background-base-lowest', '--card-shading']],
+	['members', ['--members-color', '--sidebar-color', '--background-secondary', '--card-shading']],
+	['guilds', ['--guilds-color', '--sidebar-color', '--background-tertiary']],
+	['chat', ['--main-content-color', '--background-primary', '--background-base-lower']],
+	['header', ['--header-color', '--background-primary']],
+	['composer', ['--main-textarea-color', '--channeltextarea-background', '--background-textarea']],
+	['embed', ['--card-color', '--card-shading', '--background-secondary']],
+	['modal', ['--modal-color', '--modal-shading', '--background-floating']],
+	['menu', ['--popout-color', '--popout-shading', '--background-floating']],
+	['selected', ['--background-modifier-selected']],
+	['hover', ['--background-modifier-hover']],
+	['userArea', ['--sidebar-color', '--background-secondary-alt']],
+];
+
+export function readThemeAppearance(
+	rules: ReadonlyArray<CSSStyleRule>,
+	variables: ReadonlyMap<string, string>,
+	resolve: (value: string) => string,
+	isColor: (value: string) => boolean,
+): AppearanceImport {
+	const appearance: ThemeAppearance = {};
+	const scores = new Map<keyof ThemeAppearance, number>();
+	const backgroundColors = new Map<Surface, {value: string; score: number}>();
+	const backgroundImages = new Map<Surface, {value: string | null; score: number}>();
+	const metadataVariables: Array<string> = [];
+	const textCandidates: Array<{value: string; score: number; muted?: boolean}> = [];
+	const accents: Array<{value: string; score: number}> = [];
+	let matchedRules = 0;
+	const put = (key: keyof ThemeAppearance, value: string, score: number) => {
+		if ((scores.get(key) ?? -1) > score) return;
+		appearance[key] = value;
+		scores.set(key, score);
+	};
+	const putBackground = (key: Surface, value: string | null, score: number, image: boolean) => {
+		if (image) {
+			if ((backgroundImages.get(key)?.score ?? -1) > score) return;
+			backgroundImages.set(key, {value, score});
+		} else {
+			if (!value || (backgroundColors.get(key)?.score ?? -1) > score) return;
+			backgroundColors.set(key, {value, score});
+		}
+		const result = backgroundImages.get(key)?.value ?? backgroundColors.get(key)?.value;
+		if (result) appearance[key] = result;
+	};
+	for (const [key, aliases] of TOKEN_SURFACES) {
+		for (const alias of aliases) {
+			const value = resolve(variables.get(alias) ?? '').trim();
+			if (!safeSurface(value, isColor)) continue;
+			putBackground(key, value, 0, /gradient\(/i.test(value));
+			metadataVariables.push(alias);
+			break;
+		}
+	}
+	for (const alias of ['--background-shading', '--background-overlay']) {
+		const value = resolve(variables.get(alias) ?? '').trim();
+		if (isColor(value)) {
+			putBackground('overlay', value, 0, false);
+			metadataVariables.push(alias);
+			break;
+		}
+	}
+	for (const [key, aliases] of [
+		['buttonText', ['--accent-text-color', '--button-text-color']],
+		['link', ['--text-link']],
+	] as const) {
+		for (const alias of aliases) {
+			const value = resolve(variables.get(alias) ?? '').trim();
+			if (isColor(value)) {
+				put(key, value, 0);
+				metadataVariables.push(alias);
+				break;
+			}
+		}
+	}
+	const textareaRgb = resolve(variables.get('--textarea-color') ?? '').trim();
+	const textareaAlpha = resolve(variables.get('--textarea-alpha') ?? '').trim();
+	if (/^\d{1,3}\s*,\s*\d{1,3}\s*,\s*\d{1,3}$/.test(textareaRgb) && /^(?:0?\.\d+|0|1)$/.test(textareaAlpha)) {
+		const value = `rgba(${textareaRgb},${textareaAlpha})`;
+		if (isColor(value)) {
+			putBackground('composer', value, 0, false);
+			metadataVariables.push('--textarea-color', '--textarea-alpha');
+		}
+	}
+	for (const rule of rules) {
+		let matched = false;
+		for (const selector of splitSelectors(rule.selectorText)) {
+			// Avoid light palettes, pseudoelement decorations, and feature-specific
+			// state selectors that cannot be translated into the main app surface.
+			if (/theme-light/.test(selector) && !/theme-dark/.test(selector)) continue;
+			if (/::(?:before|after)|:has\(|:not\(/.test(selector)) continue;
+			const style = rule.style;
+			const image = resolve(style.getPropertyValue('background-image')).trim();
+			const background = resolve(
+				style.getPropertyValue('background-color') || style.getPropertyValue('background'),
+			).trim();
+			const surface =
+				/gradient\(/i.test(image) && safeSurface(image, isColor)
+					? image
+					: background === 'none' || background === 'initial'
+						? 'transparent'
+						: background;
+			const color = resolve(style.getPropertyValue('color')).trim();
+			const role = componentRole(selector);
+			const priority =
+				(selector.match(/#[\w-]+/g)?.length ?? 0) * 100 +
+				(selector.match(/\.[\w-]+/g)?.length ?? 0) * 10 +
+				((style.getPropertyPriority('background') ||
+					style.getPropertyPriority('background-color') ||
+					style.getPropertyPriority('background-image')) === 'important'
+					? 10000
+					: 0);
+			if (
+				role &&
+				safeSurface(surface, isColor) &&
+				(!/:hover|:active|:focus/.test(selector) || ['selected', 'hover', 'buttonHover'].includes(role.role))
+			) {
+				const score = priority + role.weight;
+				if (safeSurface(background === 'none' || background === 'initial' ? 'transparent' : background, isColor)) {
+					putBackground(
+						role.role,
+						background === 'none' || background === 'initial' ? 'transparent' : background,
+						score,
+						false,
+					);
+				}
+				if (/gradient\(/i.test(image) && safeSurface(image, isColor)) putBackground(role.role, image, score, true);
+				else if (image || style.getPropertyValue('background')) putBackground(role.role, null, score, true);
+				matched = true;
+			}
+			if (
+				/::selection|::-webkit-scrollbar-thumb/.test(selector) &&
+				isColor(background) &&
+				colorAlpha(background) !== 0
+			) {
+				accents.push({value: background, score: /::selection/.test(selector) ? 100 : 90});
+				matched = true;
+			}
+			if (role?.role === 'selected' && isColor(surface) && colorAlpha(surface) !== 0)
+				accents.push({value: surface, score: 70});
+			if (role?.role === 'button' && isColor(surface) && colorAlpha(surface) !== 0)
+				accents.push({value: surface, score: 60});
+			if (isColor(color) && /(?:markup|messageContent|text-normal|\.name_|\.username|^body$|^html$)/.test(selector)) {
+				textCandidates.push({
+					value: color,
+					score: /markup|messageContent/.test(selector) ? 30 : 10,
+					muted: /[Mm]uted/.test(selector),
+				});
+			}
+			if (isColor(color) && /(?:colorLink|\.anchor|\sa(?:$|:))/.test(selector)) put('link', color, priority);
+			if (role && /(?:button|composer)/i.test(role.role)) {
+				const radius = resolve(style.getPropertyValue('border-radius')).trim();
+				if (/^(?:0|\d{1,3}(?:\.\d{1,2})?(?:px|rem))$/.test(radius)) put('radius', radius, priority);
+			}
+			if (role && ['embed', 'header', 'composer'].includes(role.role)) {
+				const border = resolve(style.getPropertyValue('border-color')).trim();
+				if (isColor(border)) put('border', border, priority);
+			}
+		}
+		if (matched) matchedRules++;
+	}
+	const accent = accents.sort((a, b) => b.score - a.score)[0]?.value;
+	return {
+		appearance,
+		matchedRules,
+		metadataVariables,
+		accent,
+		text: textCandidates.filter((item) => !item.muted).sort((a, b) => b.score - a.score)[0]?.value,
+		muted: textCandidates.find((item) => item.muted)?.value,
+		dimming: appearance.overlay ? colorAlpha(appearance.overlay) : undefined,
+		opacity: appearance.sidebar ? colorAlpha(appearance.sidebar) : undefined,
+	};
+}
+
+export function panelBackground(surface: string, opacity: number | string): string {
+	// Relative colour preserves the source hue while the slider controls alpha.
+	// Gradients retain their own stops and transparency.
+	if (/gradient\(/i.test(surface)) return surface;
+	return `rgb(from ${surface === 'transparent' ? '#000' : surface} r g b / ${typeof opacity === 'number' ? Math.min(1, Math.max(0, opacity)) : opacity})`;
+}
