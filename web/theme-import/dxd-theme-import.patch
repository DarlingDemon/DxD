+// SPDX-License-Identifier: AGPL-3.0-or-later
+// @vitest-environment happy-dom
+
+import {describe, expect, it} from 'vitest';
+import {buildImportedTheme, parseBetterDiscordTheme, safeColor} from './BetterDiscordImport';
+import {colorAlpha, safeSurface, splitSelectors} from './ThemeAppearanceImport';
+
+const origin = 'https://darkdck.duckdns.org';
+
+describe('general Discord appearance translation', () => {
+	it('extracts literal component colours without depending on a theme name or one CSS hash', () => {
+		const result = parseBetterDiscordTheme(
+			`
+ .app__123ab { background-image: url(https://example.com/photo.jpg); }
+ .layers__123ab {background-color: rgba(0,0,0,.75)}
+ .sidebar_abc12, .members_123ab, .chat_123ab {background: transparent !important}
+ .channelTextArea_123ab {background-color: rgba(153,17,33,.43)}
+ .modeSelected_123ab .link_123ab {background-color: rgba(153,17,33,.72)}
+ ::selection {background: #912; color: white}
+ `,
+			'any-name.theme.css',
+		);
+		expect(result.accent).toBe('#912');
+		expect(result.opacity).toBe(0);
+		expect(result.dimming).toBe(0.75);
+		expect(result.blur).toBe(0);
+		expect(result.appearance?.sidebar).toBe('transparent');
+		expect(result.appearance?.chat).toBe('transparent');
+		expect(result.appearance?.composer).toContain('153');
+		expect(result.appearance?.selected).toContain('153');
+		expect(result.mapped).toContain('surfaces');
+		const css = buildImportedTheme(result, null, origin);
+		expect(css).not.toContain('rgba(9,19,34,.52)');
+		expect(css).not.toContain('#0a1627');
+		expect(css).toContain('ChannelHeader.module__headerContainer');
+		expect(css).toContain('--brand-primary: #912');
+		expect(css).not.toContain('--dxd-panel-opacity: .98');
+	});
+	it('preserves variable-based glass themes, including HSL accent channels and input colour', () => {
+		const result = parseBetterDiscordTheme(
+			`:root {
+ --accent-hue: 260; --accent-saturation:83%; --accent-lightness:72%;
+ --accent-text-color: #000;
+ --sidebar-color: hsl(0,0%,0%,.34); --main-content-color: hsl(0,0%,0%,.27);
+ --textarea-color:255,255,255; --textarea-alpha:.125; --popout-blur:6px;
+ }`,
+			'glass.css',
+		);
+		expect(result.accent).toBe('hsl(260,83%,72%)');
+		expect(result.opacity).toBeCloseTo(0.34);
+		expect(result.dimming).toBe(0);
+		expect(result.blur).toBe(6);
+		expect(result.appearance?.buttonText).toBe('#000');
+		expect(result.appearance?.composer).toContain('.125');
+	});
+	it('keeps explicit root accents rather than guessing from decorative rules', () => {
+		const result = parseBetterDiscordTheme(':root{--main-color:#12ab34} ::selection{background:#912}', 'test.css');
+		expect(result.accent).toBe('#12ab34');
+	});
+	it('respects important panel declarations over later low-specificity overrides', () => {
+		const result = parseBetterDiscordTheme(
+			'.theme-dark .sidebar_123ab{background:transparent !important}.sidebar_123ab{background:#111}',
+			'test.css',
+		);
+		expect(result.appearance?.sidebar).toBe('transparent');
+	});
+	it('keeps a gradient when a later rule changes only its background colour', () => {
+		const result = parseBetterDiscordTheme(
+			'.lookFilled_123ab.colorBrand_123ab{background:linear-gradient(23deg,#000,#912)} .colorBrand_123ab{background-color:transparent!important}',
+			'test.css',
+		);
+		expect(result.appearance?.button).toContain('linear-gradient');
+		const reset = parseBetterDiscordTheme(
+			'.colorBrand_123ab{background:linear-gradient(23deg,#000,#912)} .colorBrand_123ab{background:transparent!important}',
+			'test.css',
+		);
+		expect(reset.appearance?.button).toBe('transparent');
+	});
+	it('never transfers source selectors or unsafe surface values into generated CSS', () => {
+		const result = parseBetterDiscordTheme(
+			'.sidebar_123ab{background-image:url(https://bad.example/tracker)}',
+			'test.css',
+		);
+		const css = buildImportedTheme(
+			{
+				...result,
+				appearance: {sidebar: 'red;display:none', chat: 'url(https://bad.example/tracker)', menu: 'var(--evil)'},
+			},
+			null,
+			origin,
+		);
+		expect(css).not.toContain('bad.example');
+		expect(css).not.toContain('display:none');
+		expect(css).not.toContain('sidebar_123ab');
+		expect(css).not.toContain('var(--evil)');
+		expect(safeSurface('url(https://bad.example/x)', safeColor)).toBe(false);
+	});
+	it.each([
+		['transparent', 0],
+		['#0000', 0],
+		['#00000080', 128 / 255],
+		['rgba(0,0,0,.4)', 0.4],
+		['hsl(0,0%,0%,.34)', 0.34],
+		['hsl(0 0% 0% / 30%)', 0.3],
+		['#912', 1],
+	])('reads alpha from %s', (color, alpha) => expect(colorAlpha(String(color))).toBeCloseTo(Number(alpha)));
+	it('splits only top-level selector commas', () => {
+		expect(splitSelectors(':is(.a,.b), .c[data-x=","]')).toEqual([':is(.a,.b)', '.c[data-x=","]']);
+	});
+});
diff --git a/fluxer_app/src/features/theme_studio/utils/ThemeAppearanceImport.ts b/fluxer_app/src/features/theme_studio/utils/ThemeAppearanceImport.ts
