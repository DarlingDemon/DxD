diff --git a/fluxer_app/src/features/theme_studio/sections/BetterDiscordImport.module.css b/fluxer_app/src/features/theme_studio/sections/BetterDiscordImport.module.css
new file mode 100644
index 0000000..f3857d3
--- /dev/null
+++ b/fluxer_app/src/features/theme_studio/sections/BetterDiscordImport.module.css
@@ -0,0 +1,145 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+.importer {
+	flex: 0 1 auto;
+	overflow: auto;
+	max-height: 75vh;
+	padding: 1rem;
+	border-bottom: 1px solid var(--studio-border);
+	background: var(--studio-bg-elevated);
+	color: var(--studio-fg-primary);
+}
+.heading,
+.actions {
+	display: flex;
+	align-items: center;
+	gap: 0.75rem;
+	flex-wrap: wrap;
+}
+.heading {
+	justify-content: space-between;
+}
+.heading h2 {
+	font-size: 1rem;
+	font-weight: 650;
+}
+.importer h3 {
+	font-size: 0.875rem;
+	font-weight: 650;
+	margin-top: 0.8rem;
+}
+.importer p {
+	font-size: 0.8rem;
+	line-height: 1.5;
+	margin: 0.5rem 0;
+}
+.inputs {
+	display: grid;
+	gap: 0.75rem;
+	margin: 0.75rem 0;
+}
+.importer label {
+	display: flex;
+	flex-direction: column;
+	gap: 0.35rem;
+	font-size: 0.8rem;
+}
+.importer input:not([type='range']),
+.importer textarea {
+	width: 100%;
+	padding: 0.5rem;
+	border: 1px solid var(--studio-border);
+	border-radius: 6px;
+	background: var(--studio-bg-sidebar);
+	color: inherit;
+}
+.importer input[type='file'] {
+	font-size: 0.75rem;
+}
+.importer input[type='range'] {
+	width: 100%;
+}
+.importer input:focus-visible,
+.importer textarea:focus-visible,
+.importer summary:focus-visible {
+	outline: 2px solid var(--brand-primary);
+	outline-offset: 2px;
+}
+.importer textarea {
+	min-height: 6rem;
+	max-height: 12rem;
+	resize: vertical;
+	font-family: monospace;
+	margin: 0.5rem 0;
+}
+.importer summary {
+	cursor: pointer;
+	font-size: 0.8rem;
+}
+.result {
+	display: grid;
+	grid-template-columns: minmax(12rem, 1fr) minmax(16rem, 2fr);
+	gap: 1.25rem;
+	margin: 1rem 0;
+}
+.controls {
+	display: flex;
+	flex-direction: column;
+	gap: 0.75rem;
+}
+.preview {
+	position: relative;
+	height: 14rem;
+	overflow: hidden;
+	border: 1px solid var(--studio-border);
+	border-radius: 10px;
+	background: #0a1627 center / cover no-repeat;
+	color: #f0f6ff;
+}
+.shade {
+	position: absolute;
+	inset: 0;
+}
+.previewInner {
+	position: relative;
+	display: grid;
+	grid-template-columns: 7rem 1fr;
+	height: 100%;
+}
+.previewInner aside {
+	padding: 0.8rem;
+	font-size: 0.8rem;
+}
+.previewChat {
+	padding: 0.8rem;
+	background: rgba(9, 19, 34, 0.52);
+	font-size: 0.8rem;
+}
+.previewChat strong {
+	display: block;
+	margin-bottom: 1.5rem;
+}
+.previewChat span {
+	display: block;
+	margin-top: 1.5rem;
+	font-size: 0.75rem;
+}
+.swatch {
+	display: inline-block;
+	margin-top: 0.75rem;
+	border-radius: 4px;
+	color: white;
+	padding: 0.3rem 0.7rem;
+}
+.warning {
+	color: var(--accent-warning);
+}
+.variables {
+	overflow-wrap: anywhere;
+	font-size: 0.75rem;
+	line-height: 1.5;
+}
+@media (max-width: 700px) {
+	.result {
+		grid-template-columns: 1fr;
+	}
+}
