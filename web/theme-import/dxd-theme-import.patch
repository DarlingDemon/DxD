+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import {describe, expect, it, vi} from 'vitest';
+import {MAX_WALLPAPER_BYTES} from './BetterDiscordImport';
+import {downloadThemeWallpaper} from './ThemeWallpaperImport';
+
+const origin = 'https://darkdck.duckdns.org';
+const source = 'https://example.com/background.jpg';
+const proxy = `${origin}/media/external/signed/background.jpg?ex=123&hm=signature`;
+const signal = () => new AbortController().signal;
+
+describe('automatic theme wallpaper download', () => {
+	it('resolves through the API and fetches only the same-origin media URL without credentials', async () => {
+		const resolve = vi.fn(async () => proxy);
+		const fetchImage = vi.fn(
+			async () => new Response(new Uint8Array([1, 2, 3]), {headers: {'Content-Type': 'image/jpeg'}}),
+		);
+		const abortSignal = signal();
+		const blob = await downloadThemeWallpaper(source, origin, resolve, abortSignal, fetchImage);
+		expect(resolve).toHaveBeenCalledWith(source, abortSignal);
+		expect(fetchImage).toHaveBeenCalledWith(proxy, {
+			signal: abortSignal,
+			credentials: 'omit',
+			redirect: 'error',
+			referrerPolicy: 'no-referrer',
+		});
+		expect(blob.type).toBe('image/jpeg');
+		expect(blob.size).toBe(3);
+	});
+	it.each([
+		'http://example.com/x',
+		'file:///etc/passwd',
+		'https://user:pass@example.com/x',
+		'data:image/png;base64,AAAA',
+	])('rejects an unsafe source URL: %s', async (url) => {
+		const resolve = vi.fn(async () => proxy);
+		await expect(downloadThemeWallpaper(url, origin, resolve, signal())).rejects.toThrow();
+		expect(resolve).not.toHaveBeenCalled();
+	});
+	it.each(['https://evil.example/media/external/image', `${origin}/api/users/@me`, `${origin}/media/attachments/x`])(
+		'does not fetch an unexpected resolved URL: %s',
+		async (url) => {
+			const fetchImage = vi.fn();
+			await expect(downloadThemeWallpaper(source, origin, async () => url, signal(), fetchImage)).rejects.toThrow();
+			expect(fetchImage).not.toHaveBeenCalled();
+		},
+	);
+	it.each(['text/html', 'image/svg+xml', 'video/mp4'])('rejects a non-raster response: %s', async (type) => {
+		const response = new Response('not an image', {headers: {'Content-Type': type}});
+		await expect(
+			downloadThemeWallpaper(
+				source,
+				origin,
+				async () => proxy,
+				signal(),
+				async () => response,
+			),
+		).rejects.toThrow();
+		expect(response.body?.locked).toBe(false);
+	});
+	it('rejects an oversized response declared in the headers', async () => {
+		const response = new Response('x', {
+			headers: {'Content-Type': 'image/png', 'Content-Length': String(MAX_WALLPAPER_BYTES + 1)},
+		});
+		await expect(
+			downloadThemeWallpaper(
+				source,
+				origin,
+				async () => proxy,
+				signal(),
+				async () => response,
+			),
+		).rejects.toThrow('too large');
+	});
+	it('enforces the byte limit even with missing or dishonest Content-Length', async () => {
+		const response = new Response(
+			new ReadableStream({
+				start(controller) {
+					controller.enqueue(new Uint8Array(MAX_WALLPAPER_BYTES));
+					controller.enqueue(new Uint8Array([1]));
+					controller.close();
+				},
+			}),
+			{headers: {'Content-Type': 'image/png', 'Content-Length': '1'}},
+		);
+		await expect(
+			downloadThemeWallpaper(
+				source,
+				origin,
+				async () => proxy,
+				signal(),
+				async () => response,
+			),
+		).rejects.toThrow('too large');
+	});
+	it('does not start resolution after cancellation', async () => {
+		const controller = new AbortController();
+		controller.abort();
+		const resolve = vi.fn(async () => proxy);
+		await expect(downloadThemeWallpaper(source, origin, resolve, controller.signal)).rejects.toThrow();
+		expect(resolve).not.toHaveBeenCalled();
+	});
+});
