+// SPDX-License-Identifier: AGPL-3.0-or-later
+// @vitest-environment happy-dom
+
+import {describe, expect, it} from 'vitest';
+import {
+	buildImportedTheme,
+	MAX_EMBEDDED_WALLPAPER_BYTES,
+	MAX_THEME_BYTES,
+	parseBetterDiscordTheme,
+	resolveImportWallpaper,
+	safeWallpaper,
+} from './BetterDiscordImport';
+
+const origin = 'https://darkdck.duckdns.org';
+const clearVision = `/** @name ClearVision */
+@import url("https://clearvision.github.io/ClearVision-v7/main.css");
+:root { --main-color: #2780e6; --hover-color: var(--main-color); --background-image: url(https://clearvision.github.io/images/sapphire.jpg); --main-font: "gg sans", Arial, sans-serif; --unused-icon: url(https://example.com/icon.svg); }
+:is(.theme-light, .theme-dark .theme-light) { --normal-text: #111; --background-shading: rgba(255,255,255,.2); }
+:is(.theme-dark, .theme-light .theme-dark) { --normal-text: #ddd; --background-shading: rgba(0,0,0,.4); }
+.discord-specific { display: none; }`;
+
+describe('BetterDiscord theme import', () => {
+	it('reads dark ClearVision settings, resolves aliases and reports omitted styling', () => {
+		const result = parseBetterDiscordTheme(clearVision, 'theme.css');
+		expect(result.name).toBe('ClearVision');
+		expect(result.accent).toBe('#2780e6');
+		expect(result.hover).toBe('#2780e6');
+		expect(result.text).toBe('#ddd');
+		expect(result.opacity).toBeCloseTo(0.25);
+		expect(result.dimming).toBeCloseTo(0.4);
+		expect(result.font).toContain('gg sans');
+		expect(result.imports).toBe(1);
+		expect(result.unsupportedVariables).toContain('--unused-icon');
+		expect(resolveImportWallpaper(result.wallpaper, origin)).toBe(`${origin}/theme-assets/clearvision-sapphire.jpg`);
+	});
+	it('recognises a literal app background, without copying Discord selectors', () => {
+		const result = parseBetterDiscordTheme(
+			'.app__160d8 { background-image: url("https://i.imgur.com/1JVM8CU.jpg"); }',
+			'Akame.theme.css',
+		);
+		expect(result.wallpaper).toBe('https://i.imgur.com/1JVM8CU.jpg');
+		expect(resolveImportWallpaper(result.wallpaper, origin)).toBe(`${origin}/theme-assets/akame.jpg`);
+		expect(resolveImportWallpaper('https://other.example/image.jpg', origin)).toBeNull();
+		const css = buildImportedTheme(result, null, origin);
+		expect(css).not.toContain('.app__160d8');
+		expect(css).not.toContain('i.imgur.com');
+	});
+	it('does not execute imports or retain hostile declarations, URLs and metadata', () => {
+		const result = parseBetterDiscordTheme(
+			`/**\n * @name Evil */ body { display: none; background-image: url(javascript:alert); } :root { --main-color: var(--cycle); --cycle: var(--main-color); --main-font: url(https://bad.example/font); }`,
+			'test.css',
+		);
+		const css = buildImportedTheme(
+			{...result, name: 'bad\n*/ body{display:none}/*', accent: 'red;display:none'},
+			'https://bad.example/tracker',
+			origin,
+		);
+		expect(css).not.toContain('display:none !important');
+		expect(css).not.toContain('bad.example');
+		expect(css).not.toContain('@import');
+		expect(css).not.toContain('javascript:');
+		expect(css).toContain('--brand-primary: #2780e6');
+		expect(safeWallpaper('https://user:pass@darkdck.duckdns.org/x', origin)).toBeNull();
+		expect(safeWallpaper('data:image/svg+xml;base64,AAAA', origin)).toBeNull();
+	});
+	it('exports a portable embedded raster image and bounded transparency', () => {
+		const result = parseBetterDiscordTheme(clearVision, 'theme.css');
+		const image = 'data:image/png;base64,aGVsbG8=';
+		const css = buildImportedTheme({...result, opacity: 99, dimming: Number.NaN, blur: -50}, image, origin);
+		expect(css).toContain(image);
+		expect(css).toContain('--dxd-panel-opacity: 1;');
+		expect(css).toContain('--dxd-wallpaper-dimming: 0;');
+		expect(css).toContain('--dxd-panel-blur: 0px;');
+	});
+	it('rejects empty and oversized input', () => {
+		expect(() => parseBetterDiscordTheme('', 'empty.css')).toThrow();
+		expect(() => parseBetterDiscordTheme('a'.repeat(MAX_THEME_BYTES + 1), 'big.css')).toThrow();
+	});
+	it('keeps the largest embedded wallpaper export below the native CSS file limit', () => {
+		const settings = parseBetterDiscordTheme(clearVision, 'theme.css');
+		const image = `data:image/webp;base64,${'A'.repeat(4 * Math.ceil(MAX_EMBEDDED_WALLPAPER_BYTES / 3))}`;
+		const css = buildImportedTheme(settings, image, origin);
+		expect(new TextEncoder().encode(css).length).toBeLessThan(MAX_THEME_BYTES);
+	});
+});
diff --git a/fluxer_app/src/features/theme_studio/utils/BetterDiscordImport.ts b/fluxer_app/src/features/theme_studio/utils/BetterDiscordImport.ts
