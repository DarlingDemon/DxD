+const pendingPanels = new WeakMap();
+
+// Queue additions are the success signal shared by the different !play sources.
+export function showPanelOnQueue(bot, msg, player) {
+  if (player._playerPanel) return;
+  pendingPanels.get(player)?.();
+  const cancel = () => {
+    clearTimeout(timer);
+    player.off("queue", onQueue);
+    player.off("leave", cancel);
+    player.off("autoleave", cancel);
+    pendingPanels.delete(player);
+  };
+  const onQueue = ({type}) => {
+    if (type !== "add" && type !== "addMany") return;
+    cancel();
+    void ensurePanel(bot, msg, player);
+  };
+  const timer = setTimeout(cancel, 120_000);
+  timer.unref?.();
+  pendingPanels.set(player, cancel);
+  player.on("queue", onQueue);
+  player.once("leave", cancel);
+  player.once("autoleave", cancel);
+}
+
+function ensurePanel(bot, msg, player) {
+  if (player._playerPanel) {
+    player._playerPanel.refresh?.();
+    return player._playerPanel.opening;
+  }
+  if (player.leaving || player._destroyed) return;
+  pendingPanels.get(player)?.();
+  const session = {};
+  player._playerPanel = session;
+  session.opening = Promise.resolve().then(() => openPanel.call(bot, msg, player, session))
+    .catch((error) => logger.warn("[Player] Could not open panel:", error?.message))
+    .finally(() => {
+      if (!session.refresh && player._playerPanel === session) delete player._playerPanel;
+    });
+  return session.opening;
+}
