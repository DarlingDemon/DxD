diff --git a/fluxer_desktop/src/main/DxDUpdater.ts b/fluxer_desktop/src/main/DxDUpdater.ts
new file mode 100644
index 00000000..f8e3956d
--- /dev/null
+++ b/fluxer_desktop/src/main/DxDUpdater.ts
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+
+import path from 'node:path';
+import {pathToFileURL} from 'node:url';
+import {createChildLogger} from '@electron/common/Logger';
+import {resolveModulePollPlan} from '@electron/common/ModulePollPlan';
+import {armDesktopUpdate, checkDesktopUpdateNow, publishDesktopUpdateCheck} from '@electron/main/DesktopUpdateGate';
+import {armDesktopUpdatePoll} from '@electron/main/DesktopUpdatePoll';
+import {onMainWindowReady, runDxDUpdateInstaller} from '@electron/main/ModuleBootHandoff';
+import {t} from '@electron/main/MainI18n';
+import {requirePrivilegedRendererDocumentSender} from '@electron/main/PrivilegedRendererDocuments';
+import {app, type BrowserWindow, dialog, ipcMain} from 'electron';
+
+const logger = createChildLogger('DxDUpdater');
+const DOWNLOAD_URL = 'https://github.com/DarlingDemon/DxD/releases/latest';
+type UpdaterContext = 'user' | 'background' | 'focus';
+interface DxDUpdateCheck {
+	readonly supported: boolean;
+	readonly available: boolean;
+	readonly version: string | null;
+}
+interface DxDUpdateRuntime {
+	readonly checkDxDUpdate: (options: {manual: boolean; signal: AbortSignal}) => Promise<DxDUpdateCheck>;
+}
+
+class UnsupportedDxDUpdateError extends Error {
+	constructor() {
+		super(`${t('desktop.update.manualDetail')}\n${DOWNLOAD_URL}`);
+	}
+}
+
+/** Wire the original update icon, menu and tray to the DxD GitHub feed. */
+export function registerDxDUpdater(getMainWindow: () => BrowserWindow | null): void {
+	const shutdown = new AbortController();
+	app.once('before-quit', () => shutdown.abort());
+	let runtime: Promise<DxDUpdateRuntime> | undefined;
+	let latest: DxDUpdateCheck | null = null;
+	let failurePrompt: Promise<unknown> | null = null;
+	const getRuntime = () => runtime ??= import(pathToFileURL(path.join(app.getAppPath(), 'startup-update.mjs')).href);
+	const send = (event: Record<string, unknown>) => {
+		const window = getMainWindow();
+		if (window != null && !window.isDestroyed()) window.webContents.send('updater-event', event);
+	};
+	const reportFailure = (error: unknown) => {
+		if (failurePrompt != null || shutdown.signal.aborted) return;
+		const options = {
+			type: 'warning' as const,
+			message: t('desktop.update.failedMessage'),
+			detail: `${t('desktop.update.failedDetail')}\n\n${error instanceof Error ? error.message : String(error)}`,
+			buttons: [t('desktop.update.ok')],
+			defaultId: 0,
+		};
+		const window = getMainWindow();
+		failurePrompt = (window != null && !window.isDestroyed() && window.isVisible()
+			? dialog.showMessageBox(window, options)
+			: dialog.showMessageBox(options))
+			.catch((promptError: unknown) => logger.warn('Could not show the update failure', {error: promptError}))
+			.finally(() => { failurePrompt = null; });
+	};
+	armDesktopUpdate({
+		check: async (manual) => {
+			const result: DxDUpdateCheck = await (await getRuntime()).checkDxDUpdate({manual, signal: shutdown.signal});
+			latest = result;
+			if (!result.supported) throw new UnsupportedDxDUpdateError();
+			return {shellNewer: result.available, modulesChanged: false};
+		},
+		start: async () => {
+			try {
+				if (runDxDUpdateInstaller == null) {
+					throw new Error(t('desktop.update.failedDetail'));
+				}
+				if (!(await runDxDUpdateInstaller(shutdown.signal))) {
+					publishDesktopUpdateCheck({shellNewer: false, modulesChanged: false});
+					send({type: 'not-available', context: 'user'});
+				}
+			} catch (error) {
+				logger.warn('The GitHub update did not install', {error});
+				reportFailure(error);
+				throw error;
+			}
+		},
+	});
+	ipcMain.handle('updater-check', async (event, context: unknown) => {
+		requirePrivilegedRendererDocumentSender(event, 'updater-check');
+		if (context !== 'user' && context !== 'background' && context !== 'focus') {
+			throw new TypeError('Invalid update check context');
+		}
+		const checkContext: UpdaterContext = context;
+		send({type: 'checking', context: checkContext});
+		try {
+			const state = await checkDesktopUpdateNow({manual: context === 'user'});
+			if (state.updating) return;
+			send(state.available
+				? {type: 'available', context: checkContext, version: latest?.version ?? null}
+				: {type: 'not-available', context: checkContext});
+		} catch (error) {
+			logger.warn('The GitHub update check failed', {error});
+			if (error instanceof UnsupportedDxDUpdateError) {
+				send({type: 'unsupported', context: checkContext, reason: app.isPackaged ? 'platform' : 'unpackaged', downloadUrl: DOWNLOAD_URL});
+			} else {
+				send({type: 'error', context: checkContext, message: error instanceof Error ? error.message : String(error)});
+			}
+		}
+	});
+	// Read-only checks keep the existing header icon current while the app runs.
+	// Installation still requires that icon/menu action, except the startup check.
+	onMainWindowReady(() => armDesktopUpdatePoll({
+		plan: resolveModulePollPlan(null),
+		check: () => checkDesktopUpdateNow(),
+		logger,
+	}, true));
+}
