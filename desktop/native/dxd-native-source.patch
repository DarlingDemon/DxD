new file mode 100644
--- /dev/null
+++ b/fluxer_desktop/src/main/DxDNativeEncoder.ts
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: AGPL-3.0-or-later
+import {createRequire} from 'node:module';
+import path from 'node:path';
+import {app} from 'electron';
+
+const requireModule = createRequire(import.meta.url);
+
+export function registerDxDNativeEncoder(): void {
+  const bridge = requireModule(path.join(app.getAppPath(), 'native-encoder-main.cjs')) as {
+    register(): void;
+  };
+  bridge.register();
+}
