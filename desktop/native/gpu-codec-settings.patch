+				setBusy(false);
+				setPending(null);
+			}
+		}
+	};
+	return (
+		<div
+			className={styles.controlStackCompact}
+			aria-busy={busy}
+			data-flx="user.advanced-settings-tab.native-encoder-controls"
+		>
+			<Combobox<NativeEncoderBackend>
+				label={messages.label}
+				aria-label={messages.label}
+				value={settings?.backend || 'auto'}
+				options={options}
+				onChange={onChange}
+				disabled={busy || !settings}
+				isLoading={busy}
+				density="compact"
+				isSearchable={false}
+				wrapMenuText
+				data-flx="user.advanced-settings-tab.select.native-encoder"
+			/>
+			<p className={styles.settingDescription} data-flx="user.advanced-settings-tab.native-encoder-description">
+				{messages.description}
+			</p>
+			{busy && (
+				<p
+					className={styles.settingDescription}
+					role="status"
+					aria-live="polite"
+					data-flx="user.advanced-settings-tab.native-encoder-status"
+				>
