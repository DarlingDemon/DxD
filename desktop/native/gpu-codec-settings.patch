+			return;
+		}
+		request.current = true;
+		setBusy(true);
+		setPending(backend);
+		setError('');
+		try {
+			const result = await bridge.setBackend(backend);
+			if (active.current) setSettings(result);
+		} catch (error) {
+			if (active.current) setError(error instanceof Error ? error.message : String(error));
+		} finally {
+			if (active.current) {
