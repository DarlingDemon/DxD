+							? messages.preparing
+							: messages.saving}
+				</p>
+			)}
+			{error && (
+				<p
+					className={styles.settingDescription}
+					role="alert"
+					data-flx="user.advanced-settings-tab.native-encoder-error"
+				>
+					{messages.failure}: {error}
+				</p>
+			)}
+		</div>
+	);
+}
